<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <ros2_control name="CarRobotHardwareInterface" type="system">
        <hardware>
            <!-- <plugin>mock_components/GenericSystem</plugin> -->
            <plugin>car_base_hardware/CarBaseHardwareInterface</plugin>
            <param name="serial_port">/dev/ttyUSB0</param>
            <param name="ticks_per_rev">20.0</param>
            <param name="max_rpm">200.0</param>
            <!-- <param name="calculate_dynamics">true</param> -->
        </hardware>

        <joint name="base_fl_wheel_joint">
            <command_interface name="velocity" />
            <state_interface name="velocity" />
            <state_interface name="position" />
        </joint>

        <joint name="base_fr_wheel_joint">
            <command_interface name="velocity" />
            <state_interface name="velocity" />
            <state_interface name="position" />
        </joint>

        <joint name="base_rl_wheel_joint">
            <command_interface name="velocity" />
            <state_interface name="velocity" />
            <state_interface name="position" />
        </joint>

        <joint name="base_rr_wheel_joint">
            <command_interface name="velocity" />
            <state_interface name="velocity" />
            <state_interface name="position" />
        </joint>

    </ros2_control>
</robot>