<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="gripper_base_length" value="0.0125" />
    <xacro:property name="gripper_base_width" value="0.05" />
    <xacro:property name="gripper_base_height" value="0.01" />

    <xacro:property name="gripper_left_finger_length" value="0.0125" />
    <xacro:property name="gripper_left_finger_width" value="0.01" />
    <xacro:property name="gripper_left_finger_height" value="0.03" />

    <xacro:property name="gripper_right_finger_length" value="0.0125" />
    <xacro:property name="gripper_right_finger_width" value="0.01" />
    <xacro:property name="gripper_right_finger_height" value="0.03" />



    <link name="gripper_base_link">
        <visual>
            <geometry>
                <box size="${gripper_base_length} ${gripper_base_width} ${gripper_base_height}"/>
            </geometry>
            <origin xyz="0 0 ${gripper_base_height / 2}" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <box size="${gripper_base_length} ${gripper_base_width} ${gripper_base_height}"/>
            </geometry>
            <origin xyz="0 0 ${gripper_base_height / 2}" rpy="0 0 0" />
        </collision>
    </link>

    <link name="gripper_left_finger">
        <visual>
            <geometry>
                <box size="${gripper_left_finger_length} ${gripper_left_finger_width} ${gripper_left_finger_height}"/>
            </geometry>
            <origin xyz="0 0 ${gripper_left_finger_height / 2}" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <box size="${gripper_left_finger_length} ${gripper_left_finger_width} ${gripper_left_finger_height}"/>
            </geometry>
            <origin xyz="0 0 ${gripper_left_finger_height / 2}" rpy="0 0 0" />
        </collision>
    </link>

    <link name="gripper_right_finger">
        <visual>
            <geometry>
                <box size="${gripper_right_finger_length} ${gripper_right_finger_width} ${gripper_right_finger_height}"/>
            </geometry>
            <origin xyz="0 0 ${gripper_left_finger_height / 2}" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <box size="${gripper_right_finger_length} ${gripper_right_finger_width} ${gripper_right_finger_height}"/>
            </geometry>
            <origin xyz="0 0 ${gripper_left_finger_height / 2}" rpy="0 0 0" />
        </collision>
    </link>


    <joint name="gripper_base_left_finger_joint" type="prismatic">
        <parent link="gripper_base_link"/>
        <child link="gripper_left_finger"/>
        <origin xyz="0 ${(gripper_base_width / 2) - (gripper_left_finger_width / 2)} ${gripper_base_height}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="${-((gripper_base_width / 2) - gripper_left_finger_width)}" upper="0.0" effort="1000.0" velocity="1.0"/>
        <mimic joint="gripper_base_right_finger_joint" multiplier="-1.0" offset="0.0"/>
    </joint>

    <joint name="gripper_base_right_finger_joint" type="prismatic">
        <parent link="gripper_base_link"/>
        <child link="gripper_right_finger"/>
        <origin xyz="0 ${-(gripper_base_width / 2) + (gripper_right_finger_width / 2)} ${gripper_base_height}" rpy="0 0 0"/>        
        <axis xyz="0 1 0"/>
        <limit lower="0.0" upper="${(gripper_base_width / 2) - gripper_left_finger_width}" effort="1000.0" velocity="1.0"/>
    </joint>

</robot>