<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="initial_positions" value="${xacro.load_yaml($(find-shar-pkg)/car_robot_moveit/config/initial_positions.yaml)['initial_positions']}"/>

    <ros2_control name="ArmController" type="system">
        <hardware>
            <!-- By default, set up controllers for simulation. This won't work on real hardware -->
            <plugin>mock_components/GenericSystem</plugin>
        </hardware>
        <joint name="arm_joint1">
            <command_interface name="position"/>
            <state_interface name="position">
                <param name="initial_value">${initial_positions['arm_joint1']}</param>
            </state_interface>
        </joint>
        <joint name="arm_joint2">
            <command_interface name="position"/>
            <state_interface name="position">
                <param name="initial_value">${initial_positions['arm_joint2']}</param>
            </state_interface>
        </joint>
        <joint name="arm_joint3">
            <command_interface name="position"/>
            <state_interface name="position">
                <param name="initial_value">${initial_positions['arm_joint3']}</param>
            </state_interface>
        </joint>
        <joint name="arm_joint4">
            <command_interface name="position"/>
            <state_interface name="position">
                <param name="initial_value">${initial_positions['arm_joint4']}</param>
            </state_interface>
        </joint>
        <joint name="arm_joint5">
            <command_interface name="position"/>
            <state_interface name="position">
                <param name="initial_value">${initial_positions['arm_joint5']}</param>
            </state_interface>
        </joint>
        <joint name="arm_joint6">
            <command_interface name="position"/>
            <state_interface name="position">
                <param name="initial_value">${initial_positions['arm_joint6']}</param>
            </state_interface>
        </joint>
        <joint name="gripper_base_right_finger_joint">
            <command_interface name="position"/>
            <state_interface name="position">
                <param name="initial_value">${initial_positions['gripper_base_right_finger_joint']}</param>
            </state_interface>
        </joint>

    </ros2_control>
</robot>
